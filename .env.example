# Supabase — Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses row-level security — never expose it to the browser.
# This is the "Secret key" (sb_secret_...) in the current Supabase dashboard,
# formerly called service_role. SUPABASE_SECRET_KEY is accepted as an alias.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Public origin. Magic-link redirects and invite links are built from it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
